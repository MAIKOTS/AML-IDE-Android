<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- Tema Principal do App herdando do AppCompat -->
    <style name="Theme.MaikoTS" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    
    <style name="LabelConfig">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">12dp</item>
    <item name="android:layout_marginBottom">6dp</item>
    <item name="android:textColor">#A1A1AA</item>
    <item name="android:textSize">11sp</item>
</style>

<style name="CampoConfig">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_input</item>
    <item name="android:paddingStart">12dp</item>
    <item name="android:paddingEnd">12dp</item>
    <item name="android:paddingTop">10dp</item>
    <item name="android:paddingBottom">10dp</item>
    <item name="android:textColor">#F4F4F5</item>
    <item name="android:textColorHint">#52525B</item>
    <item name="android:textSize">13sp</item>
    <item name="android:typeface">monospace</item>
</style>

<style name="ChipAbi">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:background">@drawable/bg_input</item>
    <item name="android:gravity">center</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
    <item name="android:textColor">#A1A1AA</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:typeface">monospace</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
</style>
    
</resources>
