<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_caminho_atual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="/storage/emulated/0/AML_IDE"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lista_diretorios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#2A2A2A"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btn_cancelar_selecao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="#333333"
            android:text="Cancelar"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_confirmar_pasta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00E676"
            android:text="Selecionar Pasta"
            android:textColor="#000000" />
    </LinearLayout>

</LinearLayout>