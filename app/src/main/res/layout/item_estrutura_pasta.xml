<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_seletor_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/itemPastaCirculo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_menu_icon_circle"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/itemPastaIcone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Pasta"
            android:src="@drawable/ic_pasta"
            android:tint="#60A5FA" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemPastaNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="pasta"
            android:textColor="@color/texto_primario"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemPastaDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:text="3 itens"
            android:textColor="@color/texto_secundario"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemPastaSeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="▶"
        android:textColor="@color/texto_secundario"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/itemPastaMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:text="⋮"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp" />
</LinearLayout>