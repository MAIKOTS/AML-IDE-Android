<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="38dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Seta de expandir -->
    <TextView
        android:id="@+id/itemPastaSeta"
        android:layout_width="14dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/texto_terciario"
        android:textSize="9sp" />

    <!-- Ícone -->
    <ImageView
        android:id="@+id/itemPastaIcone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Pasta"
        android:src="@drawable/ic_pasta"
        android:tint="#F59E0B" />

    <!-- Nome -->
    <TextView
        android:id="@+id/itemPastaNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="pasta"
        android:textColor="@color/texto_primario"
        android:textSize="13sp" />

    <!-- Contagem de itens -->
    <TextView
        android:id="@+id/itemPastaDetalhe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/texto_terciario"
        android:textSize="10sp"
        android:typeface="monospace" />
</LinearLayout>