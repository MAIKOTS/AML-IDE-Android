<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnClonarVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="← Voltar"
            android:textColor="@color/texto_primario"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Clonar Repositório"
            android:textColor="@color/verde_destaque"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="80dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda_sutil" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL do Repositório"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputUrlRepositorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_editor_area"
                android:hint="https://github.com/usuario/repo.git"
                android:inputType="textUri"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_terciario"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Branch (opcional)"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputBranch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_editor_area"
                android:hint="main"
                android:inputType="text"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_terciario"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Token de Acesso (para repositórios privados)"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_editor_area"
                android:hint="ghp_xxxxxxxxxxxxxxxxxxxx"
                android:inputType="textPassword"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_terciario"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/btnIniciarClone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_botao_confirmar"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="14dp"
                android:text="📥  Clonar Repositório"
                android:textColor="#09090B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Console de status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Status"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_editor_console">

                <TextView
                    android:id="@+id/consoleClone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Aguardando..."
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>