<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Linha 1: ícone + nome + linha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/itemResultadoIcone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Arquivo"
            android:src="@drawable/ic_arquivo_generico" />

        <TextView
            android:id="@+id/itemResultadoNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="main.cpp"
            android:textColor="@color/verde_destaque"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemResultadoLinha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L12"
            android:textColor="@color/texto_terciario"
            android:textSize="10sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- Linha 2: caminho relativo -->
    <TextView
        android:id="@+id/itemResultadoCaminho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="src/main.cpp"
        android:textColor="@color/texto_secundario"
        android:textSize="10sp"
        android:typeface="monospace" />

    <!-- Linha 3: prévia do conteúdo -->
    <TextView
        android:id="@+id/itemResultadoConteudo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="aml->Unprot(pSCAndLib + EULA_OFFSET, sizeof(bool));"
        android:textColor="@color/texto_primario"
        android:textSize="11sp"
        android:typeface="monospace" />
</LinearLayout>