<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_painel"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- ========== Ícone de destaque ========== -->
    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_icon_circle"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Permissão"
            android:src="@drawable/ic_config"
            android:tint="@color/verde_destaque" />
    </LinearLayout>

    <!-- ========== Título ========== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Acesso ao armazenamento"
        android:textColor="@color/texto_primario"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ========== Subtítulo ========== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Para funcionar como uma IDE completa, a AML IDE precisa de acesso ao armazenamento do seu dispositivo."
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />

    <!-- ========== Divisor ========== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:background="@color/borda_sutil" />

    <!-- ========== Item: Criar projetos ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_menu_icon_circle"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Criar"
                android:src="@drawable/ic_novo_projeto"
                android:tint="@color/verde_destaque" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Criar e salvar projetos"
                android:textColor="@color/texto_primario"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Seus mods ficam guardados em AML_IDE/"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== Item: Ler arquivos ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_menu_icon_circle"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Ler"
                android:src="@drawable/ic_pasta_aberta"
                android:tint="@color/verde_destaque" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abrir projetos existentes"
                android:textColor="@color/texto_primario"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Importe pastas e clone repositórios"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== Item: Compilar ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_menu_icon_circle"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Compilar"
                android:src="@drawable/ic_compilar"
                android:tint="@color/verde_destaque" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compilar código C/C++"
                android:textColor="@color/texto_primario"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Gere arquivos .so para seus mods"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== Divisor ========== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:background="@color/borda_sutil" />

    <!-- ========== Nota de privacidade ========== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:lineSpacingExtra="2dp"
        android:text="🔒  Nenhum dado sai do seu dispositivo. Seus projetos ficam apenas na sua memória local."
        android:textColor="@color/texto_terciario"
        android:textSize="11sp" />

    <!-- ========== Botão principal ========== -->
    <TextView
        android:id="@+id/btnPermissaoContinuar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_botao_confirmar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Permitir acesso"
        android:textColor="#09090B"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ========== Botão secundário ========== -->
    <TextView
        android:id="@+id/btnPermissaoCancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Agora não"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />

</LinearLayout>