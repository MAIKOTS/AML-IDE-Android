<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181B"
    android:orientation="vertical">

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="CONFIGURAÇÕES"
            android:textColor="#F4F4F5"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/configBtnFechar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Fechar"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fechar"
            android:tint="#A1A1AA" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#27272A" />

    <!-- ===================== SCROLL DE ITENS ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ========== EDITOR ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.15"
                android:text="EDITOR"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Tamanho da fonte -->
            <LinearLayout
                android:id="@+id/configItemTamanhoFonte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_config"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tamanho da fonte"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/configValorTamanhoFonte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14sp"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <!-- Word wrap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_arquivo_generico"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quebra de linha automática"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/configSwitchWordWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Números de linha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_arquivo_cpp"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Números de linha"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/configSwitchNumerosLinha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ========== CONSOLE ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.15"
                android:text="CONSOLE"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Console auto-expandir -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_terminal"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto-expandir ao compilar"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/configSwitchConsoleAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ========== COMPORTAMENTO ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.15"
                android:text="COMPORTAMENTO"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Salvar ao sair -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_guardar"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Salvar ao trocar de aba"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/configSwitchSalvarAoSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ========== SOBRE ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.15"
                android:text="SOBRE"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Sobre a IDE -->
            <LinearLayout
                android:id="@+id/configItemSobre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_ficheiro_codigo"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sobre a AML IDE"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#6B7280"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- GitHub -->
            <LinearLayout
                android:id="@+id/configItemGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_github"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GitHub"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#6B7280"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Reportar bug -->
            <LinearLayout
                android:id="@+id/configItemReportar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_terminal"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reportar um bug"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#6B7280"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Rodapé -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="AML IDE • v1.00\nFeito com ♥ por MaikoTS"
                android:textColor="#3F3F46"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>