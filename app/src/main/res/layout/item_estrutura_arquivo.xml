<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="38dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Espaço vazio (alinhamento com a seta das pastas) -->
    <View
        android:layout_width="14dp"
        android:layout_height="1dp" />

    <!-- Ícone -->
    <ImageView
        android:id="@+id/itemArquivoIcone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Arquivo"
        android:src="@drawable/ic_arquivo_generico" />

    <!-- Nome -->
    <TextView
        android:id="@+id/itemArquivoNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="arquivo.cpp"
        android:textColor="@color/texto_primario"
        android:textSize="13sp" />

    <!-- Tamanho -->
    <TextView
        android:id="@+id/itemArquivoDetalhe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1.2 KB"
        android:textColor="@color/texto_terciario"
        android:textSize="10sp"
        android:typeface="monospace" />
</LinearLayout>