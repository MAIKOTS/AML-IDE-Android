<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Barra de Ações Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#181818"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_editor_voltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:text="⬅ Voltar"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_status_aba"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="main.cpp"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_editor_salvar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:text="💾 Salvar"
            android:textColor="#00E676"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_editor_compilar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:text="▶ Compilar"
            android:textColor="#29B6F6"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Barra de Abas das Guias Abertas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141414">

        <LinearLayout
            android:id="@+id/conteiner_abas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <!-- Área de Edição (Linhas + Código) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/painel_linhas"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="#181818"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:padding="8dp"
                    android:text="1"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/campo_editor_codigo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="8dp"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </ScrollView>

    <!-- Barra de Atalhos / Símbolos Rápidos -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#181818">

        <LinearLayout
            android:id="@+id/barras_simbolos_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <!-- Console de Compilação -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_margin="8dp"
        android:background="#0A0A0A">

        <TextView
            android:id="@+id/console_de_saida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="Console pronto.\n"
            android:textColor="#00FF00"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>