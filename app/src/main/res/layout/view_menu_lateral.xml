<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181B"
    android:orientation="vertical">

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="AML IDE"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ambiente de Desenvolvimento"
            android:textColor="#A1A1AA"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#27272A" />

    <!-- ===================== SCROLL DE ITENS ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ========== NAVEGAÇÃO ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.15"
                android:text="NAVEGAÇÃO"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Tela Inicial -->
            <LinearLayout
                android:id="@+id/menu_item_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Tela Inicial"
                    android:src="@drawable/ic_casa"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tela Inicial"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Selecionar Projeto -->
            <LinearLayout
                android:id="@+id/menu_item_seletor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Selecionar Projeto"
                    android:src="@drawable/ic_importar"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Selecionar Projeto"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Estrutura do Projeto -->
            <LinearLayout
                android:id="@+id/menu_item_estrutura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Estrutura do Projeto"
                    android:src="@drawable/ic_pasta"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Estrutura do Projeto"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Editor de Código -->
            <LinearLayout
                android:id="@+id/menu_item_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Editor de Código"
                    android:src="@drawable/ic_arquivo_cpp"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Editor de Código"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ========== FERRAMENTAS ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.15"
                android:text="FERRAMENTAS"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Complementos -->
            <LinearLayout
                android:id="@+id/menu_item_ferramentas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Ferramentas da IDE"
                    android:src="@drawable/ic_config"
                    android:tint="#A1A1AA" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ferramentas da IDE"
                    android:textColor="#F4F4F5"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>