<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- ===================== TOOLBAR ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Voltar -->
        <ImageButton
            android:id="@+id/estruturaBtnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_seta_voltar"
            android:tint="@color/texto_primario" />

        <!-- Título (nome + caminho) -->
        <LinearLayout
            android:id="@+id/estruturaTituloContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/estruturaNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="Projeto"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/estruturaCaminho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/texto_secundario"
                android:textSize="9sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Buscar -->
        <ImageButton
            android:id="@+id/estruturaBtnBusca"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Buscar"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_procurar"
            android:tint="@color/texto_primario" />

        <!-- Configs -->
        <ImageButton
            android:id="@+id/estruturaBtnConfigs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Configurações do projeto"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_config"
            android:tint="@color/texto_primario" />

        <!-- Menu -->
        <ImageButton
            android:id="@+id/estruturaBtnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            android:tint="@color/texto_primario" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda_sutil" />

    <!-- ===================== BARRA DE BUSCA ===================== -->
    <LinearLayout
        android:id="@+id/estruturaBarraBusca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_procurar"
            android:tint="@color/texto_secundario" />

        <EditText
            android:id="@+id/estruturaCampoBusca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buscar no projeto..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:textColor="@color/texto_primario"
            android:textColorHint="@color/texto_terciario"
            android:textSize="13sp" />

        <!-- Toggle: nome / conteúdo -->
        <TextView
            android:id="@+id/estruturaBtnModoBusca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="Aa"
            android:textColor="@color/verde_destaque"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Fechar busca -->
        <ImageButton
            android:id="@+id/estruturaBtnFecharBusca"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar busca"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fechar"
            android:tint="@color/texto_secundario" />
    </LinearLayout>

    <View
        android:id="@+id/estruturaDivisorBusca"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda_sutil"
        android:visibility="gone" />

    <!-- ===================== BARRA DE ABAS ===================== -->
    <LinearLayout
        android:id="@+id/estruturaBarraAbas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_superficie"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/estruturaAba0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Aba 1"
            android:textColor="@color/verde_destaque"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/estruturaAba1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Aba 2"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/estruturaDivisorAbas"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda_sutil" />

    <!-- ===================== BARRA DE EDIÇÃO INLINE ===================== -->
    <LinearLayout
        android:id="@+id/estruturaBarraEdicao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_clipboard"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/estruturaEdicaoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Criar:"
            android:textColor="@color/texto_secundario"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/estruturaEdicaoInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="nome"
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:textColor="@color/texto_primario"
            android:textColorHint="@color/texto_terciario"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/estruturaEdicaoConfirmar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="✓"
            android:textColor="@color/verde_destaque"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/estruturaEdicaoCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="✕"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===================== BARRA DE CLIPBOARD ===================== -->
    <LinearLayout
        android:id="@+id/estruturaBarraClipboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_clipboard"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/estruturaClipboardTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 1 item copiado"
            android:textColor="@color/texto_primario"
            android:textSize="11sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/estruturaBtnColar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="Colar aqui"
            android:textColor="@color/verde_destaque"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/estruturaBtnCancelarClipboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="✕"
            android:textColor="#FF5252"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===================== ÁRVORE ===================== -->
    <ScrollView
        android:id="@+id/estruturaScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/estruturaArvore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="24dp" />
    </ScrollView>

</LinearLayout>