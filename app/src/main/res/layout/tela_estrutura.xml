<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- ========== Toolbar ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/estruturaBtnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="← Voltar"
            android:textColor="@color/texto_primario"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/estruturaNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="Projeto"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/estruturaCaminho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:gravity="center"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/texto_secundario"
                android:textSize="9sp"
                android:typeface="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/estruturaBtnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="⋮"
            android:textColor="@color/verde_destaque"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda_sutil" />

    <!-- ========== Barra de Edição Inline (NOVO) ========== -->
    <LinearLayout
        android:id="@+id/estruturaBarraEdicao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_clipboard"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/estruturaEdicaoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Criar:"
            android:textColor="@color/texto_secundario"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/estruturaEdicaoInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="nome"
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:textColor="@color/texto_primario"
            android:textColorHint="@color/texto_terciario"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/estruturaEdicaoConfirmar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="✓"
            android:textColor="@color/verde_destaque"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/estruturaEdicaoCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="✕"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========== Barra de Clipboard ========== -->
    <LinearLayout
        android:id="@+id/estruturaBarraClipboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_clipboard"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/estruturaClipboardTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 1 item copiado"
            android:textColor="@color/texto_primario"
            android:textSize="11sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/estruturaBtnColar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="Colar aqui"
            android:textColor="@color/verde_destaque"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/estruturaBtnCancelarClipboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="✕"
            android:textColor="#FF5252"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ========== Árvore ========== -->
    <ScrollView
        android:id="@+id/estruturaScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/estruturaArvore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp" />
    </ScrollView>

</LinearLayout>